{
	"name": "pdf-textboxes",
	"version": "1.0.0",
	"description": "Obsidian plugin: type notes onto PDFs and save them into the PDF as real text.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint .",
		"package": "npm run build && node scripts/package.mjs",
		"notices": "node scripts/notices.mjs",
		"link": "node scripts/link.mjs",
		"bench": "node scripts/bench.mjs",
		"test-pdfs": "node scripts/make-test-pdfs.mjs"
	},
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"dejavu-fonts-ttf": "^2.37.3",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "^1.14.4",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	},
	"dependencies": {
		"@pdf-lib/fontkit": "^1.1.1",
		"pdf-lib": "^1.17.1"
	},
	"author": "curryonsti",
	"repository": {
		"type": "git",
		"url": "https://github.com/curryonsti/obsidian-pdf-textboxes.git"
	}
}
